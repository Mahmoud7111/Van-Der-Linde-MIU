{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    },
    {
      "src": "views/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "app.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/views/dist/assets/$1"
    },
    {
      "src": "/(.*)\\.(.*)",
      "dest": "/views/dist/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/views/dist/index.html"
    }
  ]
}
