PORT=5000
NODE_ENV=development

MONGODB_URI=

JWT_SECRET=your_long_random_secret_here
JWT_EXPIRE=7d

FRONTEND_URL=http://localhost:5173

ADMIN_EMAIL= The email address that receives admin notifications. # Example: "A customer submitted a configuration request."

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=The Gmail account used to send emails through SMTP,is the one email account your backend logs into to send emails..
EMAIL_PASS=The Gmail App Password for EMAIL_USER,  the password that lets Nodemailer log into that sender email’s SMTP server..
EMAIL_FROM=What the customer/admin sees as the sender in their inbox.
